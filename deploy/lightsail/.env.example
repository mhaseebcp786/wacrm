# ============================================================
# /opt/wacrm/.env on the Lightsail instance.
#
# Copy this file there, fill it in, then:  chmod 600 /opt/wacrm/.env
# It is the app's runtime environment AND the source for ${VAR}s in
# compose.yml. Never commit the filled-in copy.
#
# Full descriptions of the app variables: .env.local.example at the
# repo root.
# ============================================================

# ------------------------------------------------------------
# Deployment
# ------------------------------------------------------------

# Public hostname Caddy serves and gets a certificate for. Its DNS A
# record must point at the instance's static IP.
DOMAIN=crm.example.in

# Let's Encrypt account email (expiry notices only).
ACME_EMAIL=you@example.com

# Image the stack runs. Lowercase owner/repo — GHCR rejects uppercase.
# The deploy workflow overrides this with the exact commit tag on each
# release; this value is what a manual `docker compose up -d` uses.
APP_IMAGE=ghcr.io/your-github-user/your-repo:latest

# ------------------------------------------------------------
# App — required
# ------------------------------------------------------------

# Also baked into the image at build time (GitHub repository
# variables). Keep these identical to those values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://crm.example.in
NEXT_PUBLIC_APP_LOCALE=en

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

META_APP_SECRET=your-meta-app-secret

# openssl rand -hex 32
AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ------------------------------------------------------------
# App — optional
# ------------------------------------------------------------

# META_APP_ID=your-meta-app-id
# ALLOWED_INVITE_HOSTS=crm.example.in

# ------------------------------------------------------------
# Backups (backup.sh)
# ------------------------------------------------------------

# Supabase dashboard → Connect → "Session pooler" connection string
# (IPv4-friendly; the direct connection is IPv6-only on Free).
# Replace [YOUR-PASSWORD] with the database password.
BACKUP_DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# How many days of dumps to keep on disk.
BACKUP_KEEP_DAYS=14

# pg_dump image; its major version must be >= the project's Postgres.
# BACKUP_PG_IMAGE=postgres:17-alpine
